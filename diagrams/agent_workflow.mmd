flowchart TD
    %% PawPal 2.0 architecture, part 2 of 2: after login - AI agent workflow (agent.py) + manual tools (app.py)
    %% Data flow: request -> copy to draft -> plan -> act (tools) -> check -> fix loop -> approve -> commit
    %% Manual tools (events/vacations, add task, to-do list, build schedule) save directly, with the same version check
    %% Part 1 (login & account creation) is in diagrams/account_creation.mmd
    %% Numbered edge labels (1, 2, 3) show the order a step does things in
    %% LEGEND: solid arrow (-->) = next step / function call
    %%         dotted arrow (-.->) = data, pointing the way the data moves (reads point FROM the store)
    %%         dotted line, no arrow (-.-) = covered by tests

    Legend["Legend<br/>solid arrow = next step / call<br/>dotted arrow = data, points the way it moves<br/>dotted line = covered by tests"]

    User(["👤 Pet owner"])
    Session(["⬅️ Logged-in session<br/>(diagrams/account_creation.mmd)"])

    subgraph Store["Data store (SQLite · database.py)"]
        Households[("Households<br/>code · members · pets · tasks · version")]
    end

    subgraph UI["Streamlit UI (app.py)"]
        Chat["Ask PawPal 2.0<br/>natural-language request"]
        Display["Plan display<br/>schedule + explain_plan() + agent trace<br/>+ warnings: unresolved / unfixable"]
        Changed{"Draft differs from<br/>saved household?"}
        Confirm{"Owner approves plan?<br/>approve · revise with feedback · reject"}
        VersionOK{"Saved version unchanged<br/>since run started?"}
        Commit["Commit · commit()<br/>copy Draft -> Household<br/>save, version += 1"]
        Rollback["Discard draft · rollback()<br/>reload latest household"]
        ErrorMsg["Error message<br/>draft discarded"]

        subgraph Manual["Manual tools (no AI)"]
            AvailUI["Availability<br/>home hours (or all day)<br/>+ daily care-minute limit, per member<br/>warns about tasks outside new hours"]
            AwayUI["Events & Vacations<br/>add / remove absences<br/>(all day or a time range)"]
            AddTask["Add a Task<br/>assign to a member or Anyone<br/>repeats: once · daily · weekly · every other week<br/>form clears after each task"]
            Todo["To-Do List<br/>checkbox = check_off_task()<br/>🧳 away warnings"]
            Build["Build Schedule<br/>create_daily_plan()<br/>+ conflict & away warnings"]
        end
    end

    subgraph Agent["AI Agent (agent.py · PawPalAgent.run)"]
        StartRun["Start run · start_run()<br/>round = 0<br/>copy Household -> Draft, note version"]
        Planner["1 · PLAN · plan()<br/>LLM reads request + draft state<br/>returns JSON: steps + reply"]
        Route{"Request changes<br/>the household?"}
        Answer["Answer only · answer()<br/>no edits, just explain"]
        Executor["2 · ACT · execute()<br/>LLM issues tool calls one at a time,<br/>always ending with create_daily_plan"]
        Checker["3 · CHECK · check()<br/>read conflicts + away clashes + skipped tasks<br/>split skipped into fixable / unfixable<br/>(e.g. nobody home = unfixable)"]
        Guard{"Fixable conflicts or<br/>fixable skipped tasks left?"}
        Rounds{"round under MAX_ROUNDS (3)<br/>AND count dropped last round?<br/>(always true on round 0)"}
        Fixer["4 · FIX · fix()<br/>LLM moves / reassigns / reprioritizes<br/>conflicting tasks"]
        Unresolved["flag_unresolved()<br/>remaining conflicts become warnings"]
    end

    subgraph Tools["Tool layer · ToolBox (function declarations -> Python functions)"]
        T0["add_pet<br/>(rejects duplicates)"]
        T1["add_task<br/>(needs at least 1 pet)"]
        T2["edit_task / assign_task"]
        T3["update_home_hours /<br/>update_availability"]
        T4["create_daily_plan<br/>(also runs detect_conflicts)"]
        T5["detect_conflicts /<br/>away_warnings"]
        T6["explain_plan"]
    end

    subgraph Core["PawPal 2.0 core logic (pawpal_system.py)"]
        HH["Household (saved, source of truth)<br/>owners + away dates · pets · tasks"]
        Draft["Draft household<br/>working copy for one agent run"]
        SCH["Scheduler<br/>sorting · assignment (skips people away) · timed plan<br/>daily_plan · skipped · warnings · away_warnings"]
    end

    LLM[["Google Gemini API<br/>(google-genai · function calling)<br/>auto-retry 429 / 500 / 503 / 504, up to 4 tries"]]

    subgraph Reliability["Reliability & testing"]
        Log["Agent log (RunResult.log)<br/>steps, tool calls, errors, rounds"]
        Tests["pytest · tests/test_agent.py + tests/test_away.py<br/>fake Gemini client, no real API calls"]
    end

    %% Agent run: start + plan
    Session --> Chat
    Households -. "load household" .-> HH
    Chat --> StartRun
    HH -. "copy" .-> Draft
    StartRun --> Planner
    Chat -. "request text" .-> Planner
    Draft -. "current state" .-> Planner
    Planner & Executor & Fixer -. "prompt + tool results" .-> LLM
    LLM -. "JSON plan / function calls" .-> Planner & Executor & Fixer
    Planner --> Route
    Route -- "no, question only" --> Answer
    Route -- "yes" --> Executor
    Answer -- "1 build plan" --> T4
    Answer -- "2 explain" --> T6

    %% Act
    Executor -- "new pet first" --> T0
    Executor --> T1 & T2 & T3 & T4
    T0 & T1 & T2 & T3 -. "edits" .-> Draft
    T4 --> SCH
    T5 --> SCH
    T6 --> SCH
    Draft -. "owners · pets · tasks" .-> SCH
    SCH -. "assign_unassigned_tasks" .-> Draft
    Tools -. "result / error, retry (max 2)" .-> Executor
    Tools -. "result / error, retry (max 2)" .-> Fixer
    Tools -- "retries used up: abort run" --> ErrorMsg
    Executor -- "plan built" --> Checker

    %% Check + fix loop
    Checker --> T5
    T5 -. "conflicts + away clashes + skipped tasks" .-> Checker
    Checker --> Guard
    Guard -- "no (unfixable items become warnings)" --> T6
    Guard -- "yes" --> Rounds
    Rounds -- "yes" --> Fixer
    Rounds -- "no: max rounds or no progress" --> Unresolved
    Unresolved --> T6
    Fixer -- "1 edit" --> T2
    Fixer -- "2 re-plan" --> T4
    Fixer -- "3 round += 1" --> Checker

    %% Errors
    Agent -- "Gemini API error / blocked / timeout" --> ErrorMsg
    ErrorMsg -- "discard draft" --> Rollback

    %% Review + commit
    T6 -- "explanation" --> Display
    Log -. "agent trace" .-> Display
    Checker -. "fixable / unfixable lists" .-> Display
    Unresolved -. "unresolved warnings" .-> Display
    Display -- "answer only, nothing to approve" --> Rollback
    Display -- "changes requested" --> Changed
    Draft -. "compare" .-> Changed
    HH -. "compare" .-> Changed
    Changed -- "no, nothing to save" --> Rollback
    Changed -- "yes" --> Confirm
    Confirm -- "no, reject" --> Rollback
    Confirm -- "revise with feedback: original request + rejected plan + feedback (revision_request)" --> StartRun
    Confirm -- "yes" --> VersionOK
    Households -. "current version" .-> VersionOK
    VersionOK -- "yes" --> Commit
    VersionOK -- "no, another member saved first" --> Rollback
    Draft -. "approved changes" .-> Commit
    Commit -. "copy draft" .-> HH
    Commit -. "save, version += 1" .-> Households
    Commit -- "show final plan" --> User
    Households -. "latest saved household" .-> Rollback
    Rollback --> Chat

    %% Manual tools: edit the saved household directly, saved with the version check
    Session --> AvailUI & AwayUI & AddTask & Todo & Build
    AvailUI -. "home hours + care minutes" .-> HH
    AwayUI -. "away dates" .-> HH
    AddTask & Todo -. "new / checked-off tasks" .-> HH
    HH -. "tasks + away dates" .-> SCH
    SCH -. "clash + away warnings" .-> AddTask & Todo & Build
    AvailUI & AwayUI & AddTask & Todo -. "save (version check)" .-> Households

    %% Logging + tests
    Planner & Executor & Checker & Fixer -.-> Log
    Tools -.-> Log
    Tests -.- Agent
    Tests -.- Tools
    Tests -.- Core
